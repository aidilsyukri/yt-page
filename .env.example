# YouTube Data API v3 Key — required for all YouTube features
# Get your key from https://console.cloud.google.com/ → APIs & Services → Credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# SerpAPI Key — used for Facebook page search and profile data
# Get your key from https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# Facebook App Configuration (required for OAuth login)
# Get these from https://developers.facebook.com/apps/
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# The URL where Facebook will redirect after OAuth login
# Must match exactly what's registered in your Facebook app settings
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Next.js base URL (for constructing redirect URIs)
NEXTAUTH_URL=http://localhost:3000

# Secret for signing cookies (generate with: openssl rand -base64 32)
SESSION_SECRET=your_random_session_secret_at_least_32_characters_long

# Set to "true" to use mock data (no API keys needed)
USE_MOCK_DATA=false

# Port (optional, defaults to 3000)
PORT=3000
